# Copy to profile.yaml and fill in your values

interests:
  - RL post-training
  - data synthesis
  - SGLang inference optimization

skills:
  - Python
  - distributed training

resources:
  gpus: "4x RTX 4090"
  time: part-time

watching:
  - repo: THUDM/slime
  - repo: sgl-project/sglang

output_dir: ~/workspace/osmind-packets   # reports/ are written here

# Required for `osmind report` — the LLM that judges contributability.
# OpenAI-compatible endpoint (SGLang local, DeepSeek, OpenAI, etc.).
llm:
  base_url: http://localhost:30000/v1
  model: Qwen3.5-27B
  api_key: sk-your-key-here
