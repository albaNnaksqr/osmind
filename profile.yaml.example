# Copy to ~/.config/osmind/profile.yaml and fill in your values.
# No secrets: GitHub auth is handled by `gh` (keychain); the agent is the judge,
# so there is no LLM key.

interests:
  - RL post-training
  - data synthesis
  - SGLang inference optimization

skills:
  - Python
  - distributed training

resources:
  gpus: "4x RTX 4090"
  time: part-time

watching:
  - repo: THUDM/slime
    path: ~/workspace/slime        # optional local checkout the agent may grep
  - repo: sgl-project/sglang

output_dir: ~/workspace/osmind-packets   # reports/ are written here
