# Copy to profile.yaml and fill in your values

interests:
  - RL post-training
  - data synthesis
  - SGLang inference optimization

skills:
  - Python
  - distributed training

resources:
  gpus: "4x RTX 4090"
  time: part-time

watching:
  - repo: THUDM/slime
    path: ~/workspace/slime        # optional local checkout for repo-grounded packets
    issue_limit: 100               # optional; defaults to 30
  - repo: sgl-project/sglang
    path: ~/workspace/sglang

output_dir: ~/workspace/osmind-packets   # SQLite cache + reports/ live here
# Legacy configs can still use notes_vault instead of output_dir.

vault: ~/workspace/Note   # optional Obsidian vault root; only the decision-log mirror lands here (Sources/Issue_Radar/Decision_Log.md)

# Required for `osmind report` — the LLM that judges contributability.
# OpenAI-compatible endpoint (SGLang local, DeepSeek, OpenAI, etc.).
llm:
  base_url: http://localhost:30000/v1
  model: Qwen3.5-27B
  api_key: sk-your-key-here
